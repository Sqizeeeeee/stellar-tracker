# Flask Configuration
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me-in-production
MONGO_DB_NAME=stellartracker
MONGO_URI=mongodb://admin:change-me-in-production@mongodb:27017/
MONGODB_URI=mongodb://admin:change-me-in-production@mongodb:27017/stellartracker?authSource=admin

# gRPC Services
ORCHESTRATOR_HOST=orchestrator
ORCHESTRATOR_PORT=50051
ORBIT_SERVICE_HOST=orbit-service
ORBIT_SERVICE_PORT=50052
COLLISION_SERVICE_HOST=collision-service
COLLISION_SERVICE_PORT=50053

# Grafana
GRAFANA_PASSWORD=change-me-in-production

# Orekit
OREKIT_DATA=/app/orekit-data
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# CSV Upload Configuration
CSV_CLIENT_PARSE_LIMIT=15

# Docker Registry (for CI/CD)
REGISTRY=ghcr.io
IMAGE_PREFIX=yourusername/stellartracker
TAG=latest

# Deployment (for CI/CD)
SERVER_HOST=your-server.com
SERVER_USER=deploy
DEPLOY_PATH=/opt/stellartracker